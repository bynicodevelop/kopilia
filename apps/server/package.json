{
  "name": "@kopilia/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/prune-dist.mjs src dist",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "TZ=Europe/Paris KOPILIA_SKIP_DOTENV=1 node --test --import tsx ./test/*.test.ts",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@kopilia/contracts": "workspace:*",
    "@modelcontextprotocol/sdk": "1.12.1",
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "@resvg/resvg-js": "2.6.2",
    "better-sqlite3": "11.8.1",
    "esbuild": "0.23.1",
    "express": "4.21.2",
    "metaapi.cloud-sdk": "29.3.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "ws": "8.18.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/express": "4.17.21",
    "@types/node": "22.10.5",
    "@types/ws": "8.5.13",
    "tsx": "4.19.2",
    "typescript": "5.5.4"
  }
}
