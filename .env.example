# Kopilia — configuration (copier vers .env ; jamais committé)
# Toutes les valeurs ci-dessous sont des défauts raisonnables.

# --- Serveur ---
KOPILIA_HOST=127.0.0.1
KOPILIA_PORT=4317
KOPILIA_LOG_LEVEL=info

# --- Espace de travail (racines autorisées, séparées par ':') ---
# La première racine est l'espace de travail de Kopilia : ses sous-dossiers sont
# les projets. Rien en dehors de ces racines ne peut être touché par l'ouvrier.
# Laissée en commentaire : le dossier qui contient le dépôt (par exemple ~/Documents).
# KOPILIA_PROJECT_ROOTS=/Users/ton-nom/Documents

# --- CLI Claude Code ---
# Binaire utilisé pour le dialogue, les agents et les ouvriers.
KOPILIA_CLAUDE_BIN=claude
# Partage des rôles : un DIALOGUE rapide qui délègue à des modèles plus puissants.
# (Une variable vide => modèle par défaut du compte / abonnement.)
# Dialogue vocal : rapide pour une faible latence.
KOPILIA_DIALOGUE_MODEL=claude-haiku-5-5
# Effort du dialogue (low, medium, high, xhigh, max) : « low » pour répondre vite, la réflexion de fond
# partant aux agents. Vide => l'effort réglé dans Claude Code (~/.claude/settings.json), souvent « high » :
# environ 2 s de plus avant le premier mot.
KOPILIA_DIALOGUE_EFFORT=low
# Agents de recherche (web, lecture de projets, sans rien modifier, sans confirmation).
KOPILIA_AGENT_MODEL=claude-sonnet-5-5
# Agents pour une analyse approfondie (choisie par Kopilia) ; claude-fable-5-1 possible.
KOPILIA_DEEP_MODEL=claude-opus-5-5
# Ouvriers qui AGISSENT dans un projet (après confirmation à l'écran).
KOPILIA_CLAUDE_MODEL=claude-opus-5-5
# Repli automatique si le modèle d'un agent ou d'un ouvrier est indisponible.
KOPILIA_FALLBACK_MODEL=claude-sonnet-5-5

# --- Veille économique ---
# Agent qui rédige le brief (macro, banques centrales, géopolitique) ; claude-opus-5-5 pour plus de profondeur.
KOPILIA_VEILLE_MODEL=claude-sonnet-5-5
# Wraps automatiques du lundi au vendredi (heure locale du Mac, « HH:MM », séparées par des virgules) :
# le matin, puis à midi avant l'ouverture de New York. Vide pour les désactiver.
# Rattrapés dans l'heure si le Mac dormait ou si le serveur était arrêté ; au-delà, le suivant couvre aussi leur période.
KOPILIA_BRIEF_TIMES=07:00,12:30
# Calendrier économique Forex Factory (flux officiel de la semaine en cours, sans clé).
# Récupéré dans l'heure qui suit 6 h, 12 h et 18 h (manqué : au suivant), et avant de répondre si ce n'est pas fait ;
# heures converties dans le fuseau du Mac. Vide pour le désactiver.
KOPILIA_FF_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json

# --- News en temps réel (FinancialJuice) ---
# Flux RSS public du site (lié depuis sa page d'accueil) : les 100 derniers titres, chiffres publiés compris.
# Lu toutes les 2 minutes (10 le week-end), 10 s après une annonce forte du calendrier, plus lentement si le site
# limite le débit (Cloudflare 1015) ; jamais de contournement. Ses conditions d'usage : usage personnel, pas de
# republication. Traduit par lots, avec une ligne d'impact et un niveau ; gardé pour toujours. Vide pour le désactiver.
KOPILIA_NEWS_FEED_URL=https://www.financialjuice.com/feed.ashx?xy=rss
# Modèle qui traduit les titres (un tour par lecture, sans outils).
KOPILIA_NEWS_MODEL=claude-haiku-5-5
# Mesure de la réaction du marché dans les 2 minutes qui suivent une news (0 pour la couper).
KOPILIA_NEWS_REACTIONS=1

# --- Cours en direct (MetaApi) ---
# Dernier prix d'une paire, d'un indice, de l'or… depuis le compte MetaTrader, via MetaApi (metaapi.cloud).
# Le compte se crée dans l'interface MetaApi : login MetaTrader, mot de passe (celui d'INVESTISSEUR
# suffit : lecture seule, aucun ordre possible) et serveur du courtier. Kopilia n'a besoin que de :
# - le jeton d'API MetaApi : secret, à mettre seulement dans .env, jamais dans ce fichier ;
KOPILIA_METAAPI_TOKEN=
# - l'identifiant MetaApi du compte (affiché dans l'interface) ; vide s'il n'y a qu'un compte.
KOPILIA_METAAPI_ACCOUNT_ID=

# --- Prise de position (ordres chez le courtier) ---
# Sur une boîte de trade, Kopilia calcule toujours la taille, la perte et le gain selon ton risque (money management).
# Passer les ordres est coupé par défaut. À 1, il peut préparer un ordre (entrée, stop, objectifs, break-even, clôture)
# depuis ta boîte ou à la voix, mais rien ne part sans ta confirmation : « je confirme », ou le bouton du ticket. Le
# compte MetaApi doit alors avoir le mot de passe principal (celui d'investisseur ne permet aucun ordre).
KOPILIA_TRADING_ORDERS=0
# Par prudence, les ordres ne partent que sur un compte de démonstration. À 1, aussi sur un compte réel.
KOPILIA_TRADING_LIVE=0

# --- Telegram (facultatif) ---
# Un canal ou une discussion Telegram privée où Kopilia écrit. Quand aucune page de Kopilia n'est ouverte : tes alertes
# (avec le graphique), les setups déclenchés ou abandonnés, les recherches qui repèrent des setups, le wrap (titre et
# « En bref ») et la fin de tes agents. Et, à la voix, ce que tu lui demandes d'y envoyer (« envoie le graphique de l'or
# sur Telegram »). Sans jeton ou sans identifiant de discussion, Telegram est désactivé et rien ne change.
# 1. Crée le bot avec @BotFather (/newbot) : son jeton est secret, à mettre seulement dans .env, jamais dans ce fichier-ci ;
KOPILIA_TELEGRAM_TOKEN=
# 2. Pour un canal, ajoute le bot comme administrateur (il doit pouvoir publier) ; pour une discussion privée, écris-lui.
#    Puis publie un message dans le canal (ou envoie-lui un message) et lance `pnpm telegram:chats` : il liste les
#    discussions que le bot voit, avec leur identifiant (« -100… » pour un canal).
# Ton canal technique, privé : tout ce qui part de soi-même page fermée, et ce que tu y envoies à la voix.
KOPILIA_TELEGRAM_CHAT_ID=
# 3. Tes canaux publics (facultatif), chacun avec le nom que tu diras à la voix : « public:@toncanal » ou
#    « public:-100…,signaux:-100… ». Rien d'automatique n'y part jamais : seulement ce que tu demandes en le nommant
#    (« publie sur le canal public le graphique de l'or »), d'abord en aperçu dans le canal technique, publié sur ton « oui ».
KOPILIA_TELEGRAM_CHANNELS=
# Mention en bas de chaque message public ; vide pour n'en mettre aucune.
KOPILIA_TELEGRAM_PUBLIC_FOOTER=Analyse personnelle, pas un conseil en investissement.

# --- X (ex-Twitter) ---
# Sans l'API d'X (payante) ni clé : à ta demande (« mets l'analyse de l'or sur X »), Kopilia ouvre la fenêtre de post d'X
# dans ton navigateur (là où tu es connecté à X), le texte déjà écrit, et met le graphique dans le presse-papiers.
# Tu colles l'image (⌘V) et tu cliques Poster toi-même : Kopilia ne publie jamais rien sur X. Seulement sur le Mac ; 0 le coupe.
# KOPILIA_X_COMPOSE=1
# Mention en bas de chaque post ; vide pour n'en mettre aucune.
KOPILIA_X_FOOTER=Analyse personnelle, pas un conseil en investissement.
# Longueur maximale d'un post, comptée comme X (un lien = 23, un émoji = 2) : 280, davantage avec X Premium.
# KOPILIA_X_MAX_CHARS=280

# --- Audio / STT (whisper.cpp) ---
# Vide => large-v3-turbo (models/ggml-large-v3-turbo-q5_0.bin), repli sur Base s'il manque.
# models/ggml-base.bin : ~3 fois plus rapide, mais ~4 fois plus d'erreurs en français.
KOPILIA_WHISPER_MODEL=
KOPILIA_WHISPER_LANG=fr
# Termes à bien reconnaître et corrections (« erreur => correction »).
KOPILIA_STT_VOCABULARY=config/vocabulaire.txt
# « cli » force le repli sans serveur (modèle rechargé à chaque phrase, plus lent).
KOPILIA_WHISPER_MODE=server

# --- Audio / TTS (Kokoro-82M) ---
KOPILIA_KOKORO_VOICE=ff_siwis
KOPILIA_KOKORO_LANG=f

# --- Mémoire ---
KOPILIA_MEMORY_CONTEXT_BUDGET=6

# --- Apprentissage (mémoire qui s'améliore, sur le modèle de Hermes Agent) ---
# Un relecteur relit en arrière-plan les conversations au repos (10 min) et la trace des agents :
# il tient les carnets (profil, environnement, façon de trader) et propose des recettes. 0 pour le désactiver.
KOPILIA_LEARNING=1
# Modèle du relecteur et du rangement hebdomadaire (le jugement compte plus que la vitesse).
KOPILIA_LEARNING_MODEL=claude-sonnet-5-5
# 1 : les recettes proposées sont adoptées sans attendre ton accord (sinon : à valider, à la voix ou à l'écran).
KOPILIA_LEARNING_AUTO_APPROVE=0

# --- Recherche d'opportunités (hypothèses, dossiers de setups, alertes de l'IA) ---
# Une passe après le wrap du matin et de midi, ou à la voix ; des agents réveillés par leurs alertes. 0 pour la désactiver.
KOPILIA_SETUPS=1
# Modèle des passes et des agents réveillés.
KOPILIA_SETUP_MODEL=claude-sonnet-5-5
# Les produits que tu suis, et eux seuls (un graphique ouvert n'en ajoute pas) : noms courants ou symboles,
# séparés par des virgules ; le courtier retrouve ses symboles. Ex. : Nasdaq,Dow Jones,or,EURUSD,USOIL
KOPILIA_SETUP_PRODUCTS=Nasdaq,Dow Jones,or

# --- Laboratoire de stratégies (trading algo) ---
# L'agent quant qui écrit un robot en TypeScript à partir d'une idée dite, le backteste sur les bougies du courtier
# et l'améliore dans un budget de trente essais ; le code juge. Son modèle :
KOPILIA_ALGO_MODEL=claude-sonnet-5-5
# Réveils d'agents par jour, au plus (0 : aucun réveil, les dossiers attendent la passe suivante).
KOPILIA_SETUP_WAKES_PER_DAY=40

# --- Avancé : tests et diagnostic (à laisser commenté en usage normal) ---
# Dossier des données (base SQLite, documents) ; les tests travaillent sur une copie.
# KOPILIA_DATA_DIR=data
# Commandes des workers vocaux ; les tests branchent les doubles de workers/_doubles/.
# KOPILIA_STT_CMD=node workers/whisper/run.mjs
# KOPILIA_TTS_CMD=workers/kokoro/.venv/bin/python workers/kokoro/run.py
# 0 : le dialogue n'a plus les outils de délégation (agents, ouvriers).
# KOPILIA_ENABLE_COORDINATION=1
# Jetons de l'API interne (loopback) : tirés au hasard à chaque démarrage si absents.
# Les fixer ne sert qu'aux tests (appeler l'API interne à la main).
# KOPILIA_INTERNAL_TOKEN=
# KOPILIA_AGENT_TOKEN=
# KOPILIA_LEARNING_TOKEN=
# KOPILIA_SETUP_TOKEN=
# KOPILIA_ALGO_TOKEN=
# KOPILIA_SKIP_DOTENV=1 ignore le .env : à poser dans l'environnement du processus (lue avant le .env),
# comme le font les tests pour ne pas dépendre de la configuration du poste.
# Adresses MetaApi : vides, elles sont déduites de la région du compte.
# KOPILIA_METAAPI_PROVISIONING_URL=https://mt-provisioning-api-v1.agiliumtrade.agiliumtrade.ai
# KOPILIA_METAAPI_CLIENT_URL=
# KOPILIA_METAAPI_DATA_URL=
# Cotations des encarts poussées par MetaApi (WebSocket) ; 0 = interrogées toutes les 2 s.
# KOPILIA_METAAPI_STREAM=1
# Une alerte qui part sans écran ouvert s'affiche en notification du Mac ; 0 = jamais.
# KOPILIA_ALERT_NOTIFY=1
# Adresse de l'API Bot de Telegram (les tests la remplacent par un faux serveur).
# KOPILIA_TELEGRAM_API_URL=https://api.telegram.org

# IMPORTANT : ne jamais mettre de secret dans ce fichier-ci (les jetons MetaApi et
# Telegram vont dans .env, jamais committé). Pas de clé Anthropic non plus : l'authentification
# Claude passe par le login d'abonnement du CLI.
